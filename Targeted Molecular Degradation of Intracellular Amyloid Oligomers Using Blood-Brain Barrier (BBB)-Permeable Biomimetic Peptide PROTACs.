        "outputId": "d0accabc-f837-4f20-c0a1-9592c95f941c"
      },
      "source": [
        "# Fill missing 'age' values with the median\n",
        "titanic_df['age'].fillna(titanic_df['age'].median(), inplace=True)\n",
        "\n",
        "# Fill missing 'embarked' values with the mode\n",
        "titanic_df['embarked'].fillna(titanic_df['embarked'].mode()[0], inplace=True)\n",
        "\n",
        "# Drop 'deck' column\n",
        "titanic_df.drop('deck', axis=1, inplace=True)\n",
        "\n",
        "# Create 'AgeGroup' column\n",
        "titanic_df['age_group'] = pd.cut(titanic_df['age'], bins=[0, 12, 18, 60, np.inf],\n",
        "                                 labels=['Child', 'Teenager', 'Adult', 'Elderly'])\n",
        "\n",
        "print('Data after cleaning and adding age_group:')\n",
        "display(titanic_df.head())"
